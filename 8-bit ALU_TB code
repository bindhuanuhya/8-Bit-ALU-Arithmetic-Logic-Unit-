`timescale 1ns/1ps
module tb_alu;
    reg  [7:0] A;
    reg  [7:0] B;
    reg  [3:0] opcode;

    wire [7:0] result;
    wire       carry;
    wire       zero;
    
    // Instantiate ALU
    alu uut (
        .A(A),
        .B(B),
        .opcode(opcode),
        .result(result),
        .carry(carry),
        .zero(zero)
    );
    // Generate waveform
    initial begin
        $dumpfile("alu.vcd");
        $dumpvars(0, tb_alu);
    end
    // Display results
    initial begin
    $monitor("Time=%0t | A=%h | B=%h | Opcode=%b | Result=%h | Carry=%b | Zero=%b",
                 $time, A, B, opcode, result, carry, zero);
        // -----------------------------------------
        // ADD
        // -----------------------------------------
        A = 8'h14;
        B = 8'h22;
        opcode = 4'b0000;
        #10;

        // -----------------------------------------
        // ADD with carry
        // -----------------------------------------
        A = 8'hF0;
        B = 8'h30;
        opcode = 4'b0000;
        #10;
        // -----------------------------------------
        // SUB
        // -----------------------------------------
        A = 8'h50;
        B = 8'h20;
        opcode = 4'b0001;
        #10;
        // -----------------------------------------
        // SUB resulting in zero
        // -----------------------------------------
        A = 8'h25;
        B = 8'h25;
        opcode = 4'b0001;
        #10;
        // -----------------------------------------
        // INC
        // -----------------------------------------
        A = 8'h10;
        B = 8'h00;
        opcode = 4'b0010;
        #10;
        // -----------------------------------------
        // INC with overflow
        // -----------------------------------------
        A = 8'hFF;
        B = 8'h00;
        opcode = 4'b0010;
        #10;
        // -----------------------------------------
        // DEC
        // -----------------------------------------
        A = 8'h20;
        B = 8'h00;
        opcode = 4'b0011;
        #10;
        // -----------------------------------------
        // DEC zero
        // -----------------------------------------
        A = 8'h00;
        B = 8'h00;
        opcode = 4'b0011;
        #10;
        // -----------------------------------------
        // AND
        // -----------------------------------------
        A = 8'hF0;
        B = 8'h0F;
        opcode = 4'b0100;
        #10;
        // -----------------------------------------
        // OR
        // -----------------------------------------
        A = 8'hF0;
        B = 8'h0F;
        opcode = 4'b0101;
        #10;
        // -----------------------------------------
        // XOR
        // -----------------------------------------
        A = 8'hAA;
        B = 8'h55;
        opcode = 4'b0110;
        #10;
        // -----------------------------------------
        // NOT
        // -----------------------------------------
        A = 8'h0F;
        B = 8'h00;
        opcode = 4'b0111;
        #10;

        // -----------------------------------------
        // End simulation
        // -----------------------------------------
        $finish;
      
$dumpfile("alu.vcd");
$dumpvars(0, tb_alu);
    end

endmodule
